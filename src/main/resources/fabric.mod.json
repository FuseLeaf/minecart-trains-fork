{
	"schemaVersion": 1,
	"id": "minecart-trains-fork",
	"version": "${version}",
	"name": "Minecart Trains Fork",
	"description": "Inspired by the original Minecart Trains by LarsenR. Reworks and improves minecart transportation, making it more fun and useful as a train system!",
	"authors": [
		"FuseLeaf Studio"
	],
	"contact": {
		"homepage": "https://github.com/FuseLeaf/minecart-trains-fork",
		"issues": "https://github.com/FuseLeaf/minecart-trains-fork/issues",
		"sources": "https://github.com/FuseLeaf/minecart-trains-fork"
	},
	"license": "GPL-3.0",
	"icon": "assets/minecart-trains-fork/logo/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"org.fuseleaf.minecarttrainsfork.MinecartTrainsFork"
		],
		"client": [
			"org.fuseleaf.minecarttrainsfork.client.MinecartTrainsForkClient"
		],
		"modmenu": [
			"org.fuseleaf.minecarttrainsfork.client.extension.config.ConfigEntry"
		]
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.modrinth": "https://modrinth.com/mod/minecart-trains-fork",
				"modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/minecart-trains-fork"
			}
		}
	},
	"mixins": [
		"minecart-trains-fork.mixins.json",
		{
			"config": "minecart-trains-fork.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": ">=26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"cloth-config": "*",
		"modmenu": "*"
	}
}
